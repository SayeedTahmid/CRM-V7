# Example environment variables for crm-backend
# If you want to enable Firebase Admin (Firestore + Auth), set FIREBASE_CREDENTIALS_JSON to a path
# pointing to a Firebase service account JSON file, or configure your environment to use the Google
# Application Default Credentials.

# Path to Firebase service account JSON file (optional)
FIREBASE_CREDENTIALS_JSON=credentials/serviceAccountKey.json

# If set to true, endpoints that require auth will validate Firebase ID tokens sent in
# Authorization: Bearer <id_token>
REQUIRE_AUTH=true

# Default tenant id to use when X-Tenant-ID header is not provided
DEFAULT_TENANT=default
